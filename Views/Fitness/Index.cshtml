@model IEnumerable<FitnessActivity>
@section Scripts {
  <script src="~/js/Fitness/index.js"></script>
}

<h1>Activities</h1>
<a class="btn btn-primary" asp-action="Create">Add</a>
<table class="table">
  <thead>
    <tr>
      <th scope="col">@Html.DisplayNameFor(model => model.Type)</th>
      <th scope="col">@Html.DisplayNameFor(model => model.Date)</th>
      <th scope="col">@Html.DisplayNameFor(model => model.DurationMinutes)</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var item in Model)
    {
      <tr id="item-@item.Id">
        <th scope="row">@Html.DisplayFor(model => item.Type)</th>
        <td>@Html.DisplayFor(model => item.Date)</td>
        <td>@Html.DisplayFor(model => item.DurationMinutes)</td>
        <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success">Edit</a></td>
        <td>
          <button id="delete-@item.Id" class="btn btn-danger" onclick="showConfirm(@item.Id)">Delete</button>
          <div id="confirm-@item.Id" style="display: none;">
            <button class="btn btn-danger" onclick="deleteItem(@item.Id)">Confirm</button>
            <button class="btn btn-warning" onclick="hideConfirm(@item.Id)">Cancel</button>
          </div>
        </td>
      </tr>
    }
  </tbody>
</table>